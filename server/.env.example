# 本地自托管 LLM 配置（复制为 server/.env 后填入真实值；.env 已被 .gitignore 忽略）
# 全部可选覆盖项见 functions/seqout-chat/index.ts 头部注释

# 必填：任意 OpenAI 兼容接口的密钥（OpenAI / DeepSeek / 硅基流动 / 本地 vLLM+ngrok 等均可）
# 三种给法，优先级从高到低：
#   1) 服务器/shell 环境变量：export LLM_API_KEY=sk-xxx 后启动，本文件可留空
#   2) 本文件直接填明文：LLM_API_KEY=sk-xxx
#   3) 引用服务器环境变量：LLM_API_KEY=$MY_LLM_KEY（或 ${MY_LLM_KEY}）
LLM_API_KEY=${DP_API_KEY}

# 接口根地址（须以 /v1 结尾，OpenAI 兼容 path 为 {base}/models 与 {base}/chat/completions）
LLM_BASE_URL=https://api.deepseek.com

# 请求未指定模型时的默认值
LLM_MODEL=qwen3.8-flash

# 本地服务端口
CHAT_API_PORT=8787

# 监听地址（默认 127.0.0.1 仅本机；Docker 部署已在 compose 里显式覆盖为 0.0.0.0，勿改）
# CHAT_API_HOST=127.0.0.1

# CygnusX platform-only shared read/prepare tools. Leave callback unset in standalone mode.
# Only the platform-signed delegation may authorize this callback; never use an admin API key.
# CYGNUSX_TOOL_CALLBACK_URL=http://web:8000/api/v1/agent-tools/delegated/invoke

# 可选：服务间共享密钥，仅在服务端保存，禁止打入前端。
# 配置后普通 Web 默认要求账号登录，Node 验证 Bearer 后内部附加该密钥。
# CHAT_SHARED_SECRET=
# CHAT_ACCESS_MODE=authenticated  # public 允许游客；默认无密钥 public、有密钥 authenticated
# 云账号验证：Node 可读取 VITE_SUPABASE_*，也可显式配置下列服务端变量；Edge 使用 SUPABASE_*。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# seqout 数据 API（一般无需改）
# SEQOUT_BASE_URL=https://seqout.org/api

# ENA Portal API（ena_search 工具直连源，一般无需改）
# ENA_BASE_URL=https://www.ebi.ac.uk/ena/portal/api

# NCBI E-utilities（可选：有 key 10 次/秒，无 key 限 3 次/秒）
NCBI_EMAIL=your-real-email@example.com
NCBI_API_KEY=your_ncbi_api_key

# 文献检索扩展源（均只在服务端读取，留空即可使用匿名/低配额访问）
# Crossref：建议填写邮箱，便于进入 polite pool
CROSSREF_MAILTO=your-real-email@example.com
# OpenAlex：可选 API key；邮箱用于 polite pool
OPENALEX_MAILTO=your-real-email@example.com
# OPENALEX_API_KEY=your_openalex_api_key
# Semantic Scholar：可选，配置后可获得更高请求配额
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key
# CORE：需要在 core.ac.uk 申请 API key
# CORE_API_KEY=your_core_api_key

# protocols.io 实验方案检索（可选，默认关闭）：在 https://www.protocols.io/developers
# 注册应用申请访问令牌。开关开启且令牌配置后，protocols_search / protocols_get_details /
# protocols_get_steps 三个工具才会注册进模型工具清单（未配置时工具面零变化，仅服务端读取）
# PROTOCOLS_IO_ENABLED=false
# PROTOCOLS_IO_CLIENT_ACCESS_TOKEN=
# 整根地址覆盖（一般无需改；只允许整根覆盖，路径由适配器拼接）
# PROTOCOLS_IO_API_BASE_URL=https://www.protocols.io/api
# 单次请求超时毫秒数（钳制 1000-10000，默认 7000）
# PROTOCOLS_IO_TIMEOUT_MS=7000
# 缓存 TTL 秒数（钳制 30-3600；搜索默认 300、详情默认 600，两档共用此值）
# PROTOCOLS_CACHE_TTL_SEC=300

# 宿主访问端口（默认 10087；按服务器实际可用的端口配置；被占用时 make docker-start 会报错停止）
# WEB_PORT=10087

# ---------- 以下供 Vite 前端读取（envDir 已指向 server/，本地 `pnpm run dev` 与 Docker 构建共用） ----------
# 前端对话服务地址：dev 直连本地服务（端口与 CHAT_API_PORT 一致）；
# Docker 构建由 docker-compose 固定注入 /chat-api（同源反代），不受本项影响
VITE_CHAT_API=http://localhost:8787

# 可选：配任意 Supabase 兼容实例则恢复登录/云同步/排行榜，留空则纯游客模式（构建期变量，改后需重新 build）
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_ONEDAY_APP_ID=

# 自托管账号体系（不配 Supabase 时的本地登录）：账号/聊天历史/排行榜聚合由 server/account-api.mjs
# 提供，数据落盘 DATA_DIR（默认 server/data；容器内自动为 /app/data 命名卷，与使用统计同卷持久化）。
# DATA_DIR=/path/to/data
