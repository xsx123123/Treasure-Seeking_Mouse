# 环境变量唯一来源（复制为 server/.env 后填入真实值；.env 已被 .gitignore 忽略）
# 每个变量的五要素：名称 / 用途 / 默认值 / 是否构建期（VITE_*） / 缺失行为
# 行为参数 AGENT_* 的完整清单与默认值见 functions/agent-chat/config.ts

# ---- LLM 服务 ----
# LLM_API_KEY：模型服务密钥；默认无；非构建期；缺失时服务可启动（warn），对话请求返回 503
#   三种给法，优先级从高到低：
#   1) 服务器/shell 环境变量：export LLM_API_KEY=sk-xxx 后启动，本文件可留空
#   2) 本文件直接填明文：LLM_API_KEY=sk-xxx
#   3) 引用服务器环境变量：LLM_API_KEY=$MY_LLM_KEY（或 ${MY_LLM_KEY}）
LLM_API_KEY=

# LLM_BASE_URL：OpenAI 兼容接口根地址；默认 https://api.example.com/v1（请替换为你的网关，
#   须以 /v1 结尾，兼容 path 为 {base}/models 与 {base}/chat/completions）；非构建期；
#   缺失时用默认值，请求将失败并提示
LLM_BASE_URL=https://api.example.com/v1

# LLM_MODEL：请求未指定模型时的默认值；默认 default-model（请替换）；非构建期；
#   缺失时 GET /models 用网关 defaultModel，对话用默认值
LLM_MODEL=default-model

# ---- 本地服务 ----
# CHAT_API_PORT：本地服务端口；默认 8787；非构建期；缺省即默认
CHAT_API_PORT=8787

# CHAT_API_HOST：监听地址；默认 127.0.0.1 仅本机（Docker 部署已在 compose 里显式覆盖为
#   0.0.0.0，勿改）；非构建期；缺省即默认
# CHAT_API_HOST=127.0.0.1

# CHAT_SHARED_SECRET：可选对话共享密钥；默认未配置；非构建期；
#   未配置时对话接口无鉴权（启动时会打印警告）；配置后请求必须带 X-Chat-Key 头，否则 401
# CHAT_SHARED_SECRET=

# ---- 行为参数（AGENT_*，全部可选；非法值钳制回默认，见 functions/agent-chat/config.ts） ----
# AGENT_MAX_TURNS=40              # tool-calling 轮次上限（默认 40）
# AGENT_HISTORY_WINDOW=16         # 送模型的历史条数（默认 16）
# AGENT_LLM_TIMEOUT_MS=90000      # 单轮 LLM 请求超时（默认 90000）
# AGENT_HEARTBEAT_MS=10000        # SSE 心跳间隔（默认 10000）
# AGENT_TRIM_LIMIT=100000         # LLM 输入瘦身上限字符数（默认 100000）
# AGENT_GROUNDING_VERIFY_LIMIT=5  # 单次 grounding 回源核验上限（默认 5）
# AGENT_GUEST_SESSION_LIMIT=50    # 游客本地会话数量上限（默认 50）
# AGENT_GUEST_TTL_DAYS=7          # 游客本地会话过期天数（默认 7）
# AGENT_HISTORY_SYNC_DEBOUNCE_MS=800  # 登录历史快照同步防抖（默认 800）
# AGENT_MAX_ACTORS=20000          # 使用统计内存护栏（默认 20000）

# ---- 运行数据落盘 ----
# STATS_FILE：使用统计快照路径；默认 server/.stats.json；非构建期；缺省即默认（容器挂 /app/data 卷）
# STATS_FILE=
# DATA_DIR：账号/历史/榜单数据目录；默认 server/data；非构建期；缺省即默认（容器内为 /app/data 命名卷）
# DATA_DIR=

# ---- 示例注册门模块（weather）----
# WEATHER_ENABLED：weather 工具注册开关；默认 false（零注册，开箱即纯 LLM + 内置示例工具）；
#   非构建期；与 WEATHER_API_KEY 双保险——任一缺失工具都不注册
# WEATHER_ENABLED=false
# WEATHER_API_KEY：weather 上游凭据（openweathermap.org 申请）；默认空；非构建期；
#   ENABLED 开而 KEY 空时 /stats 显示 token_missing，直调抛中文配置错误
# WEATHER_API_KEY=
# WEATHER_LIVE：weather 联网测试开关（仅 npm run test:live 消费）；默认未设=离线 fixtures
# WEATHER_LIVE=

# ---- Docker 部署 ----
# WEB_PORT：宿主访问端口；默认 10087；非构建期；被占用时 make docker-start 会报错停止
# WEB_PORT=10087

# ---- 以下供 Vite 前端读取（envDir 已指向 server/，本地 npm run dev 与 Docker 构建共用）----
# VITE_CHAT_API：前端对话服务地址；默认 http://localhost:8787；【构建期变量，改后需重新 build】；
#   dev 直连本地服务（端口与 CHAT_API_PORT 一致）；Docker 构建由 compose 固定注入 /chat-api（同源反代），
#   不受本项影响；改设为 /chat-api 可走 vite dev 同源代理（单端口、局域网可用）
VITE_CHAT_API=http://localhost:8787

# 可选云模式接入（配任意 Supabase 兼容实例则恢复云端登录，留空则纯游客 + 本地账号模式）。
# 【构建期变量，改后需重新 build】；密钥类红线：任何密钥禁止出现在 VITE_* 命名空间
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=